# ==============================================================================
# Portfolio & CMS Environment Variables Configuration
# Configure these variables in Vercel Project Settings > Environment Variables
# ==============================================================================

# --- Supabase Database & Auth Configuration (REQUIRED in Production) ---
# Supabase project HTTPS endpoint (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key (used for public PostgREST reads, keepalive, and static build)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Secret Key (SERVER-ONLY - never exposed to browser)
# Used exclusively server-side for admin CRUD operations and audit logging
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Vercel Cron Keepalive Security (REQUIRED in Production) ---
# Random 32+ character secret string used to authorize Vercel Cron keepalive requests
# When Vercel Cron triggers /api/cron/keepalive, it passes Authorization: Bearer ${CRON_SECRET}
CRON_SECRET=generate-random-32-char-secret-string

# --- Vercel Static Rebuild Deploy Hook (REQUIRED for Option A Static Publishing) ---
# Generated in Vercel Project Settings > Git > Deploy Hooks
# Triggers an automated static build and edge deployment upon publication or rollback
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_.../...

# --- Admin Session & Origin Security (OPTIONAL / DEFAULTS PROVIDED) ---
# Canonical production site origin (defaults to https://pranav-shenoy-portfolio.vercel.app)
CANONICAL_ORIGIN=https://pranav-shenoy-portfolio.vercel.app

# Comma-separated list of additional trusted origins (if using custom domains)
# ADMIN_ALLOWED_ORIGINS=https://shenoypranav.com,https://www.shenoypranav.com

# Comma-separated list of additional trusted preview hostnames (e.g. specific preview deployments)
# TRUSTED_PREVIEW_DOMAINS=pranav-shenoy-portfolio-git-antigravity-updates.vercel.app

# Cryptographic salt for rate-limiting client IP hashing (falls back to built-in default if unset)
# RATE_LIMIT_HMAC_SECRET=generate-random-32-char-salt

# Upstash Redis for distributed multi-region rate limiting (optional; falls back to memory if unset)
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
